maios_account_profile {
    account_id = "maios_user_ghazi_01";
    username = "Ghazi";
    email = "ghazi@maios.com"; // Menggunakan domain resmi MAIOS
    edition_membership = "Maimai Edition - Lifetime VIP";
    auth_provider = "MAIOS_Independent_Auth";
    cloud_sync_enabled = false; // Berjalan otonom tanpa dependensi Google Services
}

security_credentials {
    encryption_standard = "AES-256-MAIOS";
    biometric_lock = true;
    token_validity_period = "permanent";
    identity_domain = "auth.maios.com";
}

autonomous_preferences {
    bypass_google_services = true;
    allow_third_party_accounts = false;
    local_storage_path = "/data/data/com.maios.service/files/maios_account/";
    sync_mode = "Peer-to-Peer_Local";
}

session_history {
    last_login = "2026-11-05T21:00:00Z";
    device_name = "Android_Studio_Maimai_Build";
    status = "Active";
}
